    "email": "Mr.jwswain@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://playstorewizard.pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/3000Studios/playstorewizard.pro.git"
  },
  "contributors": [
    {
      "name": "3000 Studios",
      "url": "https://github.com/3000Studios"
    }
  ],
  "overrides": {
    "postcss": "$postcss"
  }
}
